# Biometric Attendance System - Backend Environment Configuration
# Copy this file to backend/.env and update values for your environment.

# ============ FLASK CORE ============
FLASK_ENV=production
FLASK_DEBUG=0

# ============ DATABASE CONFIGURATION ============
MONGO_URI=mongodb://localhost:27017/biometric_attendance
MONGO_DB_AUTH=biometric_auth
MONGO_DB_ACADEMIC=biometric_academic
MONGO_DB_ATTENDANCE=biometric_attendance_ops
MONGO_DB_AUDIT=biometric_audit

# ============ SECURITY: JWT & AUTHENTICATION ============
# Generate a strong secret:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_THIS_BEFORE_RUNNING  # Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
STRICT_JWT_SECRET=0
TEMP_PASS_DISPLAY_ENABLED=0

# Cookie settings
JWT_COOKIE_SAMESITE=Lax
JWT_COOKIE_CSRF_PROTECT=1
JWT_COOKIE_DOMAIN=
JWT_ACCESS_TOKEN_EXPIRES_SECONDS=3600
ENABLE_DEFAULT_ADMIN_SEED=0
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
FACE_EMBEDDING_ENCRYPTION_KEY=  # Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ============ SECURITY: CORS ============
CORS_ORIGINS=http://localhost:5173

# ============ SECURITY: RATE LIMITING ============
RATELIMIT_ENABLED=1
RATELIMIT_STORAGE_URI=memory://  # WARNING: memory:// is NOT safe for production. Use Redis in production: redis://localhost:6379/1

# ============ SECURITY: BRUTE FORCE PROTECTION ============
BRUTE_FORCE_PROTECTION_ENABLED=1
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_DURATION_MINUTES=15
LOGIN_ATTEMPT_WINDOW_MINUTES=15
PIN_MAX_ATTEMPTS=3
PIN_LOCKOUT_DURATION_MINUTES=5
IP_RATELIMIT_THRESHOLD=100
IP_RATELIMIT_WINDOW_MINUTES=10

# ============ SECURITY: PASSWORD POLICY ============
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=1
PASSWORD_REQUIRE_LOWERCASE=1
PASSWORD_REQUIRE_DIGITS=1
PASSWORD_REQUIRE_SPECIAL=1

# ============ SECURITY: SESSION & AUDIT ============
SECURE_SESSION_TIMEOUT_MINUTES=30
REQUIRE_CSRF_ON_MUTATION=1
AUDIT_LOGGING_ENABLED=1
LOG_SENSITIVE_OPERATIONS=1
AUDIT_LOG_RETENTION_DAYS=90

# ============ FACE RECOGNITION ============
FACENET_THRESHOLD=0.65
ATTENDANCE_THRESHOLD=75.0
# Controls how lecturers authenticate when committing attendance.
# Options: pin (default) | face (biometric — requires lecturer face profile enrolled)
LECTURER_AUTH_MODE=pin

# ============ FILE UPLOADS & PERFORMANCE ============
UPLOAD_FOLDER=uploads
SLOW_REQUEST_THRESHOLD_MS=500
QUERY_CACHE_MAX_ENTRIES=500
ACTIVE_SESSION_TIMEOUT_MINUTES=180

# ============ TASK QUEUE (Optional) ============
TASK_QUEUE_ENABLED=0
TASK_QUEUE_REDIS_URL=redis://localhost:6379/0
TASK_QUEUE_NAME=biometric:jobs
TASK_QUEUE_MAX_RETRIES=3
TASK_QUEUE_BASE_BACKOFF_SECONDS=10
TASK_QUEUE_MAX_BACKOFF_SECONDS=300
TASK_QUEUE_BACKOFF_JITTER_RATIO=0.25
TASK_QUEUE_RUNNING_TIMEOUT_SECONDS=900

# ============ DATA LIFECYCLE RETENTION (days) ============
UPLOAD_RETENTION_DAYS=14
DATASET_RETENTION_DAYS=365
TRAINER_ARTIFACT_RETENTION_DAYS=30
BACKUP_RETENTION_DAYS=30

# ============ OBSERVABILITY SETTINGS ============
LOGGING_LEVEL=INFO
LOGGING_FORMAT=text
ERROR_TRACKING_ENABLED=1
SENTRY_DSN=
SENTRY_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=0.1
METRICS_ENABLED=1
METRICS_PORT=9090
HEALTH_CHECK_ENABLED=1

# ============ SECURITY: RESPONSE HEADERS ============
CONTENT_SECURITY_POLICY=default-src 'self'; img-src 'self' data: blob:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' http: https: ws: wss:; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
HSTS_ENABLED=0
HSTS_MAX_AGE_SECONDS=31536000
HSTS_INCLUDE_SUBDOMAINS=1
HSTS_PRELOAD=0

# ============ EMAIL DELIVERY (Yagmail) ============
YAGMAIL_USER=your-email@gmail.com
YAGMAIL_PASSWORD=your-gmail-app-password
YAGMAIL_SMTP_HOST=smtp.gmail.com
YAGMAIL_SMTP_PORT=587
YAGMAIL_SMTP_SSL=0
YAGMAIL_SMTP_STARTTLS=1
APP_LOGIN_URL=http://localhost:5173/login

# ============ NOTES ============
# 1. Do not commit backend/.env with real secrets.
# 2. Use strong secrets and production-safe CORS values before deployment.
# 3. Set FACE_EMBEDDING_ENCRYPTION_KEY in production before storing biometric templates.
# 4. Set YAGMAIL_USER and YAGMAIL_PASSWORD to enable welcome emails with temp passwords. Excel imports still work without it; imported accounts will just skip email delivery.
# 5. Set TEMP_PASS_DISPLAY_ENABLED=1 only when temporary password responses must be visible in admin UI.
