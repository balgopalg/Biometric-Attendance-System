# Biometric Attendance System - Environment Configuration Example
# Copy this to .env and fill in with your actual values

# ============ FLASK CORE ============
FLASK_ENV=production
FLASK_DEBUG=0

# ============ SECURITY: JWT & AUTHENTICATION ============
# CRITICAL: Must be a strong random string (64+ characters) in production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=dev-only-strong-secret-change-in-production-to-64-char-random-string

# Enforce strong JWT secret validation
STRICT_JWT_SECRET=true

# Cookie security settings
JWT_COOKIE_SECURE=true              # HTTPS only in production
JWT_COOKIE_SAMESITE=Strict          # Lax or Strict for security
JWT_COOKIE_DOMAIN=                  # Leave blank or set specific domain

# CSRF Protection
JWT_COOKIE_CSRF_PROTECT=true        # Always enable in production

# ============ SECURITY: CORS ============
# Restrict to your actual frontend domain(s)
CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
CORS_SUPPORTS_CREDENTIALS=true

# ============ SECURITY: RATE LIMITING ============
RATELIMIT_ENABLED=true

# For distributed deployments, use Redis instead of memory://
# RATELIMIT_STORAGE_URL=redis://localhost:6379/0
RATELIMIT_STORAGE_URL=memory://

# ============ SECURITY: BRUTE FORCE PROTECTION ============
BRUTE_FORCE_PROTECTION_ENABLED=true

# Login lockout settings
LOGIN_LOCKOUT_THRESHOLD=5              # Failed attempts before lockout
LOGIN_LOCKOUT_DURATION_MINUTES=15      # Minutes to lock account
LOGIN_ATTEMPT_WINDOW_MINUTES=15        # Time window for attempt counting

# PIN entry protection
PIN_MAX_ATTEMPTS=3                     # Failed PIN attempts before blocking
PIN_LOCKOUT_DURATION_MINUTES=5         # Minutes to block PIN attempts

# IP-based rate limiting
IP_RATELIMIT_THRESHOLD=100             # Max requests from IP in window
IP_RATELIMIT_WINDOW_MINUTES=10         # Time window for IP rate limit

# ============ SECURITY: PASSWORD POLICY ============
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGITS=true
PASSWORD_REQUIRE_SPECIAL=true

# ============ SECURITY: SESSION & AUDIT ============
SECURE_SESSION_TIMEOUT_MINUTES=30      # Inactivity timeout
REQUIRE_CSRF_ON_MUTATION=true          # Enforce CSRF on POST/PUT/DELETE

AUDIT_LOGGING_ENABLED=true             # Enable audit trail
LOG_SENSITIVE_OPERATIONS=true          # Log admin actions
AUDIT_LOG_RETENTION_DAYS=90            # Keep audit logs for N days

# ============ DATABASE CONFIGURATION ============
MONGO_URI=mongodb://localhost:27017/biometric_attendance
MONGO_DB_AUTH=biometric_auth
MONGO_DB_ACADEMIC=biometric_academic
MONGO_DB_ATTENDANCE=biometric_attendance_ops
MONGO_DB_AUDIT=biometric_audit

# ============ FACE RECOGNITION ============
FACENET_THRESHOLD=0.60                 # 0.6+ recommended, higher = stricter matching

# ============ FILE UPLOADS ============
UPLOAD_FOLDER=uploads                  # Relative to backend root
# Max upload size (16 MB default)
# MAX_CONTENT_LENGTH=16777216

# ============ PERFORMANCE ============
SLOW_REQUEST_THRESHOLD_MS=500          # Log requests slower than this

# ============ TASK QUEUE (Optional) ============
TASK_QUEUE_ENABLED=false
TASK_QUEUE_REDIS_URL=redis://localhost:6379/0
TASK_QUEUE_NAME=biometric:jobs
TASK_QUEUE_MAX_RETRIES=3
TASK_QUEUE_BASE_BACKOFF_SECONDS=10
TASK_QUEUE_MAX_BACKOFF_SECONDS=300
TASK_QUEUE_BACKOFF_JITTER_RATIO=0.25
TASK_QUEUE_RUNNING_TIMEOUT_SECONDS=900

# ============ NOTES ============
# 1. NEVER commit .env with real secrets to version control
# 2. Use strong, random values for all SECRET/KEY variables
# 3. Ensure JWT_COOKIE_SECURE=true in production (requires HTTPS)
# 4. Restrict CORS_ORIGINS to your actual frontend domain
# 5. For distributed systems, use Redis for rate limiting
# 6. Review and update AUDIT_LOG_RETENTION_DAYS based on your retention policy
# 7. Monitor failed login attempts and IP-based attacks
